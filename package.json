{
  "name": "folio",
  "version": "1.0.0",
  "description": "Folio — 写真報告書・点検報告書のPDF結合とExcel転記用テキスト抽出",
  "scripts": {
    "dev": "next dev -p 3502",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "rm -f tsconfig.tsbuildinfo && tsc --noEmit",
    "postinstall": "node scripts/copy-assets.mjs",
    "dump": "tsx scripts/dump-textcontent.mts",
    "help:shots": "tsx scripts/help-shots/index.mts",
    "report:assets": "python3 scripts/build_report_template.py && python3 scripts/build_report_fonts.py",
    "report:geometry": "python3 scripts/extract_report_geometry.py",
    "report:dump": "tsx scripts/dump-report.mts",
    "dev:lan": "node scripts/dev-lan.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@cantoo/pdf-lib": "2.9.1",
    "@google/genai": "^2.18.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sparticuz/chromium": "153.0.0",
    "fflate": "^0.8.3",
    "harfbuzzjs": "^1.6.0",
    "next": "^16.3.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.2.108",
    "playwright-core": "1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@xmldom/xmldom": "^0.9.12",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "private": true
}
