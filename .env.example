# アフター受付内容の要約に使う Gemini API キー (無料枠で取得可: https://aistudio.google.com/apikey)
# 未設定でも動作します (ルールベースの定型要約に自動フォールバック)
GEMINI_API_KEY=

# 使用モデル (カンマ区切りで複数指定すると、1日の上限に達した順に自動で次へ切り替えます)。
# 無料枠は「モデル単位で1日20リクエスト」なので、並べるほど1日に処理できる件数が増えます。
# 省略時の既定:
#   画像認識: gemini-3.5-flash, gemini-3-flash-preview, gemini-3.6-flash:default
#   要約:     gemini-3.5-flash-lite, gemini-3.1-flash-lite
# 「モデル名:思考レベル」で指定でき、省略時は MINIMAL (最速)。default はモデル既定の思考。
# GEMINI_VISION_MODELS=gemini-3.5-flash, gemini-3-flash-preview, gemini-3.6-flash:default
# GEMINI_SUMMARY_MODELS=gemini-3.5-flash-lite, gemini-3.1-flash-lite
# 施主名のカナ読み推定 (メール文用) に使うモデル列。省略時は要約と同じ
# GEMINI_KANA_MODELS=gemini-3.5-flash-lite, gemini-3.1-flash-lite

# デプロイ時のパスワード保護。設定すると全ページ・APIが認証必須になる (ログイン画面が出る)。
# ローカル開発では未設定のままでよい。ユーザー名は APP_USER (省略時 user)
# APP_USER=user
# APP_PASSWORD=
# ログインを保持する日数 (省略時 30日・最大365)。共有端末では短くする
# APP_SESSION_DAYS=30

# 楽楽精算の取得 (顛末書・専決決裁書・捺印決裁書)。
# ★ Vercel では Production スコープにだけ入れる (プレビューが本番を触らないように)。
# ★ テナントのURLと部門名は会社ごとの情報なので、コードには書かない。
# RAKURAKU_LOGIN_URL=https://...
# RAKURAKU_DEPT_NAME=
# ログイン状態を預けるときの暗号鍵 (32文字以上のでたらめな文字列)。
# 変えると、それまでに配られたセッションはすべて無効になる。
# RAKURAKU_SESSION_SECRET=
# プレビュー環境でも動かしたいときだけ 1 (既定は無効)
# RAKURAKU_ALLOW_PREVIEW=
# 開発中に使うブラウザ (既定: mac=chrome / windows=msedge)、画面を出すなら HEADFUL=1
# RAKURAKU_BROWSER_CHANNEL=
# RAKURAKU_HEADFUL=
